//////////////////// HELPER FUNCTIONS /////////////////////////
float LimitFlowRate(float flow_rate_in, float waterDepth_left, float terrain_left, float waterDepth_right, float terrain_right, float cflFactor) {
	if (flow_rate_in >= 0.f) {
		if (waterDepth_left <= minWaterHeight || (terrain_left + waterDepth_left <= terrain_right))
			return 0.f;
		return min(flow_rate_in, cflFactor * waterDepth_left);
	} else {
		if (waterDepth_right <= minWaterHeight || (terrain_right + waterDepth_right <= terrain_left))
			return 0.f;
		return max(flow_rate_in, -cflFactor * waterDepth_right);
	}
}

float SampleCubicClamped2D(Texture2D<float> dataField, float2 samplePos) {
    // 1. Calculate integer base and fractional coordinates
    int2 id_start = (int2)floor(samplePos) - 1;
    float2 frac = samplePos - floor(samplePos);
    
    // 2. Safely clamp all 4x4 grid indices to the domain boundaries
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 id0 = clamp(id_start,     int2(0,0), maxGrid);
    int2 id1 = clamp(id_start + 1, int2(0,0), maxGrid);
    int2 id2 = clamp(id_start + 2, int2(0,0), maxGrid);
    int2 id3 = clamp(id_start + 3, int2(0,0), maxGrid);

    // 3. Precompute cubic weights for X and Y
    float2 frac2 = frac * frac;
    float2 frac3 = frac2 * frac;
    float4 wX = float4(
        -frac3.x + 2.f * frac2.x - frac.x,
         3.f * frac3.x - 5.f * frac2.x + 2.f,
        -3.f * frac3.x + 4.f * frac2.x + frac.x,
         frac3.x - frac2.x
    ) * 0.5f;
    float4 wY = float4(
        -frac3.y + 2.f * frac2.y - frac.y,
         3.f * frac3.y - 5.f * frac2.y + 2.f,
        -3.f * frac3.y + 4.f * frac2.y + frac.y,
         frac3.y - frac2.y
    ) * 0.5f;

    // 4. Load the 16 values explicitly (reusing registers)
    float v00 = dataField[int2(id0.x, id0.y)];
    float v10 = dataField[int2(id1.x, id0.y)];
    float v20 = dataField[int2(id2.x, id0.y)];
    float v30 = dataField[int2(id3.x, id0.y)];

    float v01 = dataField[int2(id0.x, id1.y)];
    float v11 = dataField[int2(id1.x, id1.y)]; // c00
    float v21 = dataField[int2(id2.x, id1.y)]; // c10
    float v31 = dataField[int2(id3.x, id1.y)];

    float v02 = dataField[int2(id0.x, id2.y)];
    float v12 = dataField[int2(id1.x, id2.y)]; // c01
    float v22 = dataField[int2(id2.x, id2.y)]; // c11
    float v32 = dataField[int2(id3.x, id2.y)];

    float v03 = dataField[int2(id0.x, id3.y)];
    float v13 = dataField[int2(id1.x, id3.y)];
    float v23 = dataField[int2(id2.x, id3.y)];
    float v33 = dataField[int2(id3.x, id3.y)];

    // 5. Interpolate along X for each row
    float row0 = wX.x * v00 + wX.y * v10 + wX.z * v20 + wX.w * v30;
    float row1 = wX.x * v01 + wX.y * v11 + wX.z * v21 + wX.w * v31;
    float row2 = wX.x * v02 + wX.y * v12 + wX.z * v22 + wX.w * v32;
    float row3 = wX.x * v03 + wX.y * v13 + wX.z * v23 + wX.w * v33;

    // 6. Interpolate the 4 row results along Y
    float result = wY.x * row0 + wY.y * row1 + wY.z * row2 + wY.w * row3;

    // 7. Monotonicity clamp (reusing the already-loaded values)
    float minVal = min(min(v11, v21), min(v12, v22));
    float maxVal = max(max(v11, v21), max(v12, v22));

    return clamp(result, minVal, maxVal);
}

float2 ComplexMul(float2 a, float2 b) {
    return float2(a.x * b.x - a.y * b.y,
                  a.x * b.y + a.y * b.x);
}

float SafeTanh(float x) {
    if (x > 20.f)       return 1.f;
    else if (x < -20.f) return -1.f;
    else                return tanh(x);
}

precise float SolveJacobi(float u_orig, float sigma, float u_E, float u_W, float u_N, float u_S, float C_E, float C_W, float C_N, float C_S) {
    // u is the quantity being diffused, C is the diffusion coefficient
    // E, W, N, S are cardinal directions - neighbor cells
    precise float numerator = u_orig + sigma * (C_E * u_E + C_W * u_W + C_N * u_N + C_S * u_S);
    precise float denominator = 1.0f + sigma * (C_E + C_W + C_N + C_S);
    return numerator / denominator;
}

float SpongeDamping(uint2 id, bool isYDir = false) {
    // If the cell is in the interior (outside the sponge boundary), return 1.0 immediately
    if (id.x >= (uint)spongeThickness && id.x < (uint)(gridSizeX - spongeThickness) &&
        id.y >= (uint)spongeThickness && id.y < (uint)(gridSizeY - spongeThickness)) {
        return 1.f;
    }

    float x = (float)id.x;
    float y = (float)id.y;
    float distX = min((float)spongeThickness, (x < (float)gridSizeX / 2.f) ? x : (float)gridSizeX - x);
    float distY = min((float)spongeThickness, (y < (float)gridSizeY / 2.f) ? y : (float)gridSizeY - y);
    
    float invSpongeThickness = 1.f / (float)spongeThickness;
    float ratioX = ((float)spongeThickness - distX) * invSpongeThickness;
    float ratioY = ((float)spongeThickness - distY) * invSpongeThickness;
    
    return (1.f - ratioX * ratioX) * (1.f - ratioY * ratioY);
}

//////////////////// COMPUTE SHADERS /////////////////////////

/////////// Init ///////////

float WaterLevel;
float TerrainCaptureCameraZ;
[numthreads(16, 16, 1)]
void InitializeWater(uint3 id : SV_DispatchThreadID) {
    // Inputs: terrain (raw capture scene depth in cm)
    // Outputs: hOut (water height), HOut (total elevation), terrainOut (converted terrain height in meters), terrainOutCM (visual terrain height in cm)
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    float rawDepth = terrain[id.xy];
    if (isnan(rawDepth) || isinf(rawDepth) || rawDepth <= 0.f || rawDepth > 1000000.f) {
        rawDepth = TerrainCaptureCameraZ;
    }
    float terrainHeight = (TerrainCaptureCameraZ - rawDepth) * 0.01f;
    float h_val = max(0.f, WaterLevel - terrainHeight);
    // if (id.y < 0.25f * gridSizeY) { // for testing: step function
    //     h_val += 2.f;
    // }
    hOut[id.xy] = h_val;
    H_Out[id.xy] = terrainHeight + h_val;
    terrainOut[id.xy] = terrainHeight;
    terrainOutCM[id.xy] = terrainHeight * 100.0f; // Converted terrain height in centimeters
}

/////////// Decomposition ///////////

[numthreads(16, 16, 1)]
void InitDecomp(uint3 id : SV_DispatchThreadID) {
    // Inputs: hIn, qIn_x, qIn_y, terrain
    // Outputs: HOut, QOut_x, QOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    H_Out[id.xy] = hIn[id.xy] + terrain[id.xy];
    Q_Out_x[id.xy] = qIn_x[id.xy];
    Q_Out_y[id.xy] = qIn_y[id.xy];
}

[numthreads(16, 16, 1)]
void CalcDiffusionCoeffs(uint3 id : SV_DispatchThreadID) {
    // Inputs: HIn, terrain
    // Outputs: alpha_HOut, alpha_QOut_x, alpha_QOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr  = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);

    float h = clamp(H_In[curr] - terrain[curr], 0.f, maxSafeDepth);
    float hr = clamp(H_In[right] - terrain[right], 0.f, maxSafeDepth);
    float hu = clamp(H_In[up] - terrain[up], 0.f, maxSafeDepth);
    hr = (h + hr) * 0.5f;
    hu = (h + hu) * 0.5f;
    float grad_x = (H_In[right] - H_In[curr]) * rcp(cellSize);
    float grad_y = (H_In[up] - H_In[curr]) * rcp(cellSize);
    float penalty = exp(- diffusionPenalty * (grad_x * grad_x + grad_y * grad_y));

    float max_alpha = 0.5 * (maxDiffusionCells * cellSize) * (maxDiffusionCells * cellSize);
    alpha_HOut[curr]   = clamp(0.5 * h  * h * penalty,  0.0f, max_alpha);
    alpha_QOut_x[curr] = clamp(0.5 * hr * hr * penalty, 0.0f, max_alpha);
    alpha_QOut_y[curr] = clamp(0.5 * hu * hu * penalty, 0.0f, max_alpha);
}

[numthreads(16, 16, 1)]
void DiffusionStep(uint3 id : SV_DispatchThreadID) {
    // Inputs: terrain, H_Orig, Q_Orig_x, Q_Orig_y, 
    //         H_Past, Q_Past_x, Q_Past_y,
    //         alpha_HIn, alpha_QIn_x, alpha_QIn_y
    // Outputs: H_Out, Q_Out_x, Q_Out_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), maxGrid);
    int2 ru    = clamp(curr + int2(1, 1), int2(0, 0), maxGrid);
    int2 rd    = clamp(curr + int2(1, -1), int2(0, 0), maxGrid);
    int2 lu    = clamp(curr + int2(-1, 1), int2(0, 0), maxGrid);

    float aH_curr  = alpha_HIn[curr];
    float aH_right = alpha_HIn[right];
    float aH_left  = alpha_HIn[left];
    float aH_up    = alpha_HIn[up];
    float aH_down  = alpha_HIn[down];
    float a_topright = 0.25f * (aH_curr + aH_up   + aH_right + alpha_HIn[ru]);
    float a_botright = 0.25f * (aH_curr + aH_down + aH_right + alpha_HIn[rd]);
    float a_topleft  = 0.25f * (aH_curr + aH_up   + aH_left  + alpha_HIn[lu]);

    float invCellSizeSq = rcp(cellSize * cellSize);
    precise float newH    = SolveJacobi(H_Orig[curr],   invCellSizeSq, H_Past[right],   H_Past[left],   H_Past[up],   H_Past[down],   alpha_QIn_x[curr], alpha_QIn_x[left], alpha_QIn_y[curr], alpha_QIn_y[down]);
    H_Out[curr]   = max(terrain[curr], newH);
    precise float newQx   = SolveJacobi(Q_Orig_x[curr], invCellSizeSq, Q_Past_x[right], Q_Past_x[left], Q_Past_x[up], Q_Past_x[down], aH_right,   aH_curr,   a_topright, a_botright);
    Q_Out_x[curr] = newQx;
    precise float newQy   = SolveJacobi(Q_Orig_y[curr], invCellSizeSq, Q_Past_y[right], Q_Past_y[left], Q_Past_y[up], Q_Past_y[down], a_topright, a_topleft, aH_up,      aH_curr);
    Q_Out_y[curr] = newQy;
}

[numthreads(16, 16, 1)]
void DecomposeFields(uint3 id : SV_DispatchThreadID) {
    // Inputs: HIn, QIn_x, QIn_y
    //         hIn, qIn_x, qIn_y, terrain
    // Outputs: hbarOut, qbarOut_x, qbarOut_y, 
    //          htildeOut, qtildeOut_x, qtildeOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    
    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 up = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);

    float h_curr = hIn[curr];
    float h_right = hIn[right];
    float h_up = hIn[up];
    float t_curr = terrain[curr];
    float t_right = terrain[right];
    float t_up = terrain[up];
    float hbar = clamp(H_In[curr] - t_curr, 0.f, maxSafeDepth);
    float hbar_right = clamp(H_In[right] - t_right, 0.f, maxSafeDepth);
    float hbar_up = clamp(H_In[up] - t_up, 0.f, maxSafeDepth);
    
    float cflFactor = cflCondition * cellSize / timeStep;
    hbarOut[curr] = hbar;
    qbarOut_x[curr] = LimitFlowRate(Q_In_x[curr], h_curr, t_curr, h_right, t_right, cflFactor);
    qbarOut_y[curr] = LimitFlowRate(Q_In_y[curr], h_curr, t_curr, h_up,    t_up,    cflFactor);
    htildeOut[curr] = hIn[curr] - hbar;
    qtildeOut_x[curr] = qIn_x[curr] - qbarOut_x[curr];
    qtildeOut_y[curr] = qIn_y[curr] - qbarOut_y[curr];
}

/////////// eWave ///////////
// These all have slight variants on the names so HLSL doesn't get mad for redefining a name used before

[numthreads(16, 16, 1)]
void TransferToFFT(uint3 id : SV_DispatchThreadID) {
    // Inputs: htildeIn, qtildeIn_x, qtildeIn_y, htildeOld
    // Outputs: htildeOldNext, hHat, qHat_x, qHat_y
    if (id.x >= (uint)(paddedGridSizeX) || id.y >= (uint)(paddedGridSizeY)) return;

    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) {
        hHat[id.xy]   = float2(0.0f, 0.0f);
        qHat_x[id.xy] = float2(0.0f, 0.0f);
        qHat_y[id.xy] = float2(0.0f, 0.0f);
        return;
    }

    float h_real = 0.5 * (htildeIn[id.xy] + htildeOld[id.xy]);
    htildeOldNext[id.xy] = htildeIn[id.xy];
    hHat[id.xy]   = float2(h_real, 0.0f);
    qHat_x[id.xy] = float2(qtildeIn_x[id.xy], 0.0f);
    qHat_y[id.xy] = float2(qtildeIn_y[id.xy], 0.0f);
}

[numthreads(16, 16, 1)]
void CalcEWave(uint3 id : SV_DispatchThreadID) {
    // Inputs: hHat, qHat_x, qHat_y, depth
    // Outputs: qHat_x_array, qHat_y_array
    if (id.x >= (uint)(paddedGridSizeX) || id.y >= (uint)(paddedGridSizeY)) return;

    // Early return for DC component 
    if (id.x == 0 && id.y == 0) {
        qhat_x_array[id] = qhat_x[id.xy];
        qhat_y_array[id] = qhat_y[id.xy];
        return;
    }

    ///// Wave Number ///////
    // Calculate the physical size of the grid and the frequency step (dK) in each dimension
    float domainSizeX = (float)paddedGridSizeX * cellSize;
    float domainSizeY = (float)paddedGridSizeY * cellSize;
    float dKx = 2.0f * PI / domainSizeX; 
    float dKy = 2.0f * PI / domainSizeY;
    float NXdiv2 = (float)paddedGridSizeX / 2.0f;
    float NYdiv2 = (float)paddedGridSizeY / 2.0f;
    // Calculate the physical 2D wavenumber vector components (signed, handling the Nyquist wrap-around)
    int freqX = (id.x < NXdiv2) ? (int)id.x : (int)id.x - (int)paddedGridSizeX;
    int freqY = (id.y < NYdiv2) ? (int)id.y : (int)id.y - (int)paddedGridSizeY;
    float kx = (float)freqX * dKx; // spatial frequency: radians per meter
    float ky = (float)freqY * dKy;
    float k2 = kx * kx + ky * ky;
    if (k2 < 1e-12) {
        qhat_x_array[id] = qhat_x[id.xy];
        qhat_y_array[id] = qhat_y[id.xy];
        return;
    }
    float invK = rsqrt(k2);
    float k = k2 * invK;
    // Unit vectors
    float kx_ = kx * invK;
    float ky_ = ky * invK;
    float kx2 = kx_ * kx_;
    float ky2 = ky_ * ky_;

    /////// Dispersion ///////
    // numerical dispersion correction
    float beta = sqrt((2.0 / (k * cellSize)) * sin(k * cellSize / 2.0)); // From their 1D code, but different from paper
    // float beta = sqrt((2.0 * k / cellSize) * sin(k * cellSize / 2.0)); // correct formula from paper, but not stable?
    // Angular frequency for dispersion relation
    float omega = sqrt(GRAVITY * k * SafeTanh(k * min(getDepthLevel(id.z), maxSafeDepth))) / beta;
    float S = sin(omega * timeStep) * omega / k2;
    float C = cos(omega * timeStep);
    float Cx = C * kx2 + ky2;
    float Cy = C * ky2 + kx2;
    float Ck = (C-1) * kx_ * ky_;

    /////// Gradient of Shifted hHat ///////
    // Fourier gradient along wave direction: dh/dx = hhat * (i * k)
    float2 dh = ComplexMul(hhat[id.xy], float2(0, k));
    // Phase shift in X: shift by dx/2 by multiplying by e^(i * shiftX) = cos(shiftX) + i*sin(shiftX)
    float theta_x = 0.5f * cellSize * kx;
    float theta_y = 0.5f * cellSize * ky;
    float2 shift_x = float2(cos(theta_x), sin(theta_x));
    float2 shift_y = float2(cos(theta_y), sin(theta_y));
    float2 dhdx = ComplexMul(dh, shift_x);
    float2 dhdy = ComplexMul(dh, shift_y);

    // Shift the q cross-terms to align with their target faces
    theta_x = 0.5f * cellSize * (ky - kx);
    theta_y = 0.5f * cellSize * (kx - ky);
    shift_x = float2(cos(theta_x), sin(theta_x));
    shift_y = float2(cos(theta_y), sin(theta_y));
    float2 qx_shifted = ComplexMul(qhat_x[id.xy], shift_x); // now on top face
    float2 qy_shifted = ComplexMul(qhat_y[id.xy], shift_y); // now on right face
    // float2 qx_shifted = qhat_x[id.xy];
    // float2 qy_shifted = qhat_y[id.xy];

    /////// Update Q ///////
    // Shift to cell centers, do the following, shift back to faces
    // 1) Decompose q into parallel and perpendicular: q_|| = kx_*qx + ky_*qy, q_T = kx_*qy - ky_*qx
    // 2) Update in rotated basis: q_||+ = C*q_|| - S*dhdx (q_T unchanged bc Airy is irrotational)
    // 3) Recombine: qx = kx_*q_||+ - ky_*q_T, qy = ky_*q_||+ + kx_*q_T
    qhat_x_array[id] = Cx * qhat_x[id.xy] + Ck * qy_shifted - kx_ * S * dhdx;
    qhat_y_array[id] = Cy * qhat_y[id.xy] + Ck * qx_shifted - ky_ * S * dhdy;
    // qhat_x_array[id] = C * qhat_x[id.xy] - S * dhdx; // Naive 1D translation, but does just as well?
    // qhat_y_array[id] = C * qhat_y[id.xy] - S * dhdy;

    if ((id.x == NXdiv2 && id.y == 0) || (id.x == 0 && id.y == NYdiv2) || (id.x == NXdiv2 && id.y == NYdiv2)) {
        qhat_x_array[id] = float2(qhat_x_array[id].x, 0.0f);
        qhat_y_array[id] = float2(qhat_y_array[id].x, 0.0f);
    }
}

[numthreads(16, 16, 1)]
void InterpQ(uint3 id : SV_DispatchThreadID) {
    // Inputs: qHat_x_array, qHat_y_array, hbarIn, depth
    // Outputs: qtildeOut_x, qtildeOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    uint2 right = uint2(min(id.x + 1, gridSizeX - 1), id.y);
    uint2 up    = uint2(id.x, min(id.y + 1, gridSizeY - 1));

    // float waterDepth_x = min(max(hbarIn[id.xy], hbarIn[right]), maxSafeDepth);
    // float waterDepth_y = min(max(hbarIn[id.xy], hbarIn[up]), maxSafeDepth);
    float waterDepth_x = min(0.5f * (hbarIn[id.xy] + hbarIn[right]), maxSafeDepth);
    float waterDepth_y = min(0.5f * (hbarIn[id.xy] + hbarIn[up]), maxSafeDepth);
    int d1_x = 0;
    int d1_y = 0;
    for (int d = 0; d < depthNum; d++) {
        if (waterDepth_x >= getDepthLevel(d)) d1_x = d;
        if (waterDepth_y >= getDepthLevel(d)) d1_y = d;
    }
    int d2_x = min(depthNum - 1, d1_x + 1);
    int d2_y = min(depthNum - 1, d1_y + 1);
    float sx = 0.f;
    float sy = 0.f;

    if (waterDepth_x < getDepthLevel(0)) {
        sx = waterDepth_x / getDepthLevel(0);
        qtildeOut_x[id.xy] = sx * qHat_x_array[uint3(id.x, id.y, 0)].x;
    } else {
        if (d1_x != d2_x)
            sx = (getDepthLevel(d2_x) - waterDepth_x) / (getDepthLevel(d2_x) - getDepthLevel(d1_x));
        qtildeOut_x[id.xy] = sx * qHat_x_array[uint3(id.x, id.y, d1_x)].x + (1.f - sx) * qHat_x_array[uint3(id.x, id.y, d2_x)].x;
    }

    if (waterDepth_y < getDepthLevel(0)) {
        sy = waterDepth_y / getDepthLevel(0);
        qtildeOut_y[id.xy] = sy * qHat_y_array[uint3(id.x, id.y, 0)].x;
    } else {
        if (d1_y != d2_y)
            sy = (getDepthLevel(d2_y) - waterDepth_y) / (getDepthLevel(d2_y) - getDepthLevel(d1_y));
        qtildeOut_y[id.xy] = sy * qHat_y_array[uint3(id.x, id.y, d1_y)].x + (1.f - sy) * qHat_y_array[uint3(id.x, id.y, d2_y)].x;
    }
}

/////////// SWE ///////////

[numthreads(16, 16, 1)]
void CalcUbar(uint3 id : SV_DispatchThreadID) {
    // Inputs: qbarIn_x, qbarIn_y, hbarIn
    // Outputs: ubarOut_x, ubarOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);

    // First-Order Up-Winding with regularized division near zero depth
    float hx = (qbarIn_x[curr] >= 0.f || curr.x == gridSizeX-1) ? hbarIn[curr] : hbarIn[right];
    float hy = (qbarIn_y[curr] >= 0.f || curr.y == gridSizeY-1) ? hbarIn[curr] : hbarIn[up];
    hx = min(hx, maxSafeDepth);
    hy = min(hy, maxSafeDepth);
    float localUbar_x = (hx <= minWaterHeight) ? 0.f : (qbarIn_x[curr] * rcp(hx));
    float localUbar_y = (hy <= minWaterHeight) ? 0.f : (qbarIn_y[curr] * rcp(hy));
    
    // Enforcing CFL condition for later surface waves advection
    float cflFactor = cflCondition * cellSize / timeStep;
    ubarOut_x[curr] = clamp(localUbar_x, -cflFactor, cflFactor);  
    ubarOut_y[curr] = clamp(localUbar_y, -cflFactor, cflFactor); 
}

[numthreads(16, 16, 1)]
void CalcSWE(uint3 id : SV_DispatchThreadID) {
    // Inputs: ubarIn_x, ubarIn_y, hbarIn, HIn, delH_x, delH_y (gradients of FFT wave height)
    // Outputs: ubarNewOut_x, ubarNewOut_y, qbarOut_x, qbarOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), maxGrid);
    int2 r2    = clamp(curr + int2(2, 0), int2(0, 0), maxGrid);
    int2 u2    = clamp(curr + int2(0, 2), int2(0, 0), maxGrid);

    // Use upwinding to evaluate q_(i-0.5,j), q_(i+0.5,j), q_(i+1.5,j) 
    // for x direction to get q_x_(i,j), q_x_(i+1,j)
    float q_x_m05 = ubarIn_x[left] * ((ubarIn_x[left] >= 0.f) ? hbarIn[left] : hbarIn[curr]);
    float q_x_p05 = ubarIn_x[curr] * ((ubarIn_x[curr] >= 0.f) ? hbarIn[curr] : hbarIn[right]);
    float q_x_p15 = ubarIn_x[right]* ((ubarIn_x[right]>= 0.f) ? hbarIn[right]: hbarIn[r2]);
    float q_x_0 = 0.5f * (q_x_m05 + q_x_p05);
    float q_x_1 = 0.5f * (q_x_p05 + q_x_p15);
    float q_y_m05 = ubarIn_y[down] * ((ubarIn_y[down] >= 0.f) ? hbarIn[down] : hbarIn[curr]);
    float q_y_p05 = ubarIn_y[curr] * ((ubarIn_y[curr] >= 0.f) ? hbarIn[curr] : hbarIn[up]);
    float q_y_p15 = ubarIn_y[up]   * ((ubarIn_y[up]   >= 0.f) ? hbarIn[up]   : hbarIn[u2]);
    float q_y_0 = 0.5f * (q_y_m05 + q_y_p05);
    float q_y_1 = 0.5f * (q_y_p05 + q_y_p15);
    
    // Calculate h_(i+0.5,j)
    float h_x_p05 = clamp((hbarIn[curr] + hbarIn[right]) * 0.5f, 0.f, maxSafeDepth);  
    float h_y_p05 = clamp((hbarIn[curr] + hbarIn[up]) * 0.5f, 0.f, maxSafeDepth);

    // Calculate corresponding values for u_x_(i,j) using upwinding
    float u_x_0 = (q_x_0 >= 0.f) ? ubarIn_x[left] : ubarIn_x[curr];
    float u_x_1 = (q_x_1 >= 0.f) ? ubarIn_x[curr] : ubarIn_x[right]; 
    float u_y_0 = (q_y_0 >= 0.f) ? ubarIn_y[down] : ubarIn_y[curr];
    float u_y_1 = (q_y_1 >= 0.f) ? ubarIn_y[curr] : ubarIn_y[up];       

    // Compute dux_dt and duy_dt 
    float eps = minWaterHeight;
    float invH_x = h_x_p05 / (h_x_p05 * h_x_p05 + eps * eps);
    float invH_y = h_y_p05 / (h_y_p05 * h_y_p05 + eps * eps);
    float dux_dt = (h_x_p05 <= minWaterHeight) ? 0.f : -rcp(cellSize * h_x_p05) * ((q_x_1 * u_x_1 - q_x_0 * u_x_0) - ubarIn_x[curr] * (q_x_1 - q_x_0));
    float duy_dt = (h_y_p05 <= minWaterHeight) ? 0.f : -rcp(cellSize * h_y_p05) * ((q_y_1 * u_y_1 - q_y_0 * u_y_0) - ubarIn_y[curr] * (q_y_1 - q_y_0));
    
    // Calculate wave gradient
    float gradh_x = (H_In[right] - H_In[curr]) * rcp(cellSize);
    float gradh_y = (H_In[up]    - H_In[curr]) * rcp(cellSize);

    // Calculate FFT wave forcing
    float depthWeight = SafeTanh(hbarIn[curr] * rcp(depthCutoff)); // scaling term to reduce FFT waves in shallow water
    gradh_x += depthWeight * delH_x[curr]; // FFT wave pressure gradient 
    gradh_y += depthWeight * delH_y[curr];
 
    // Limit steep waves: when wave gets too steep, it "crashes"
    gradh_x = clamp(gradh_x, -slopeLimit, slopeLimit);
    gradh_y = clamp(gradh_y, -slopeLimit, slopeLimit);

    // Incorporate gravity force and bottom friction 
    float bottomFriction = 0.05f; // subtle bottom drag to allow water to settle to rest
    precise float dux_dt_total = dux_dt - (GRAVITY * gradh_x + bottomFriction * ubarIn_x[curr]);
    precise float duy_dt_total = duy_dt - (GRAVITY * gradh_y + bottomFriction * ubarIn_y[curr]);

    // Integrate u, calculate q
    float cflFactor = cflCondition * cellSize / timeStep;
    precise float localUbarNew_x = clamp(ubarIn_x[curr] + timeStep * dux_dt_total, -cflFactor, cflFactor);
    precise float localUbarNew_y = clamp(ubarIn_y[curr] + timeStep * duy_dt_total, -cflFactor, cflFactor);

    float h_x_face = (localUbarNew_x >= 0.f) ? hbarIn[curr] : hbarIn[right];
    float h_y_face = (localUbarNew_y >= 0.f) ? hbarIn[curr] : hbarIn[up];
    if (h_x_face <= minWaterHeight) localUbarNew_x = 0.f;
    if (h_y_face <= minWaterHeight) localUbarNew_y = 0.f;

    ubarNewOut_x[curr] = localUbarNew_x;
    ubarNewOut_y[curr] = localUbarNew_y;
    qbarOut_x[curr] = LimitFlowRate(localUbarNew_x * h_x_face, hbarIn[curr], terrain[curr], hbarIn[right], terrain[right], cflFactor);
    qbarOut_y[curr] = LimitFlowRate(localUbarNew_y * h_y_face, hbarIn[curr], terrain[curr], hbarIn[up],    terrain[up],    cflFactor);
}


/////////// Transport & Combine ///////////

[numthreads(16, 16, 1)]
void UpdateTilde(uint3 id : SV_DispatchThreadID) {
    // Inputs: ubarNewIn_x, ubarIn_x, ubarNewIn_y, ubarIn_y, 
    //         qtildePast_x, qtildePast_y, hIn, htildeOut
    // Outputs: htildeOut, qtildeOut_x, qtildeOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), maxGrid);
    int2 rdown = clamp(curr + int2(1, -1), int2(0, 0), maxGrid);
    int2 uleft = clamp(curr + int2(-1, 1), int2(0, 0), maxGrid);

    ///// Q Update /////

    // integrate at midpoint of timestep 
    float ubar_x_avg = 0.5f * (ubarNewIn_x[curr] + ubarIn_x[curr]); 
    float ubar_y_avg = 0.5f * (ubarNewIn_y[curr] + ubarIn_y[curr]);
    float ubar_x_left  = 0.5f * (ubarNewIn_x[left] + ubarIn_x[left]);
    float ubar_x_right  = 0.5f * (ubarNewIn_x[right] + ubarIn_x[right]);
    float ubar_y_right  = 0.5f * (ubarNewIn_y[right] + ubarIn_y[right]);
    float ubar_y_down  = 0.5f * (ubarNewIn_y[down] + ubarIn_y[down]);
    float ubar_x_up  = 0.5f * (ubarNewIn_x[up] + ubarIn_x[up]);
    float ubar_y_up  = 0.5f * (ubarNewIn_y[up] + ubarIn_y[up]);
    float ubar_y_rdown = 0.5f * (ubarNewIn_y[rdown] + ubarIn_y[rdown]);
    float ubar_x_uleft = 0.5f * (ubarNewIn_x[uleft] + ubarIn_x[uleft]);

    // ubar divergence
    float div_ubar  = (ubar_x_avg   - ubar_x_left  + ubar_y_avg   - ubar_y_down)  * rcp(cellSize);  // at cell center
    float div_right = (ubar_x_right - ubar_x_avg   + ubar_y_right - ubar_y_rdown) * rcp(cellSize); // at center of right cell
    float div_up    = (ubar_x_up    - ubar_x_uleft + ubar_y_up    - ubar_y_avg)   * rcp(cellSize);  // at center of up cell
    float div_ux = 0.5f * (div_ubar + div_right); // at right boundary
    float div_uy = 0.5f * (div_ubar + div_up); // at up boundary

    // // Clamp divergence to prevent exponential growth during flow convergence
    // float maxDivergence = 1.0f / max(1e-4f, timeStep);
    // div_ubar = max(div_ubar, -maxDivergence);
    // div_ux   = max(div_ux,   -maxDivergence);
    // div_uy   = max(div_uy,   -maxDivergence);

    // Dampen if converging to avoid breaking waves
    div_ubar *= (div_ubar < 0.f) ? gammaTransport : 1; 
    div_ux   *= (div_ux   < 0.f) ? gammaTransport : 1;
    div_uy   *= (div_uy   < 0.f) ? gammaTransport : 1;

    // Update qtilde using exponential integration & semi-lagrangian advection
    float ubar_x_at_yface = 0.25 * (ubar_x_left + ubar_x_avg + ubar_x_uleft + ubar_x_up); // at center of up face
    float ubar_y_at_xface = 0.25 * (ubar_y_down + ubar_y_avg + ubar_y_rdown + ubar_y_right); // at center of right face
    float timeStepOverCellSize = timeStep * rcp(cellSize);
    float2 step_x = -float2(ubar_x_avg, ubar_y_at_xface) * timeStepOverCellSize; // unitless (cells)
    float2 step_y = -float2(ubar_x_at_yface, ubar_y_avg) * timeStepOverCellSize; // unitless (cells)
    qtildeOut_x[curr] = SampleCubicClamped2D(qtildePast_x, id.xy + step_x) * exp(-div_ux * timeStep);
    qtildeOut_y[curr] = SampleCubicClamped2D(qtildePast_y, id.xy + step_y) * exp(-div_uy * timeStep);

    ///// H Update /////
    // Update htildeOut using ubar divergence (not at middle of timestep)
    div_ubar = (ubarNewIn_x[curr] - ubarNewIn_x[left] + ubarNewIn_y[curr] - ubarNewIn_y[down]) * rcp(cellSize);
    // div_ubar = max(div_ubar, -maxDivergence);
    div_ubar *= (div_ubar < 0.f) ? gammaTransport : 1; // dampen if converging to avoid breaking waves
    htildeOut[curr] = htildeCopy[curr] * exp(-div_ubar * timeStep);
}

[numthreads(16, 16, 1)]
void CalcQAdvect(uint3 id : SV_DispatchThreadID) {
    // Inputs: ubarNewIn_x, ubarNewIn_y, htildeIn
    // Outputs: qAdvect_x, qAdvect_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), maxGrid);
    int2 rdown = clamp(curr + int2(1, -1), int2(0, 0), maxGrid);
    int2 uleft = clamp(curr + int2(-1, 1), int2(0, 0), maxGrid);

    // cubic reconstruction: 1/2 cell accounts for staggered grid, 0.5 * dt accounts for h and u at different 1/2 times
    float halfTimeStepOverCellSize = (0.5f * timeStep) / cellSize;
    float ubar_avg_x = 0.25 * (ubarNewIn_x[left] + ubarNewIn_x[curr] + ubarNewIn_x[uleft] + ubarNewIn_x[up]); // average ubar_x centered at top face
    float ubar_avg_y = 0.25 * (ubarNewIn_y[down] + ubarNewIn_y[curr] + ubarNewIn_y[rdown] + ubarNewIn_y[right]); // average ubar_y centered at right face
    float2 step_x = float2(0.5f, 0.0f) - float2(ubarNewIn_x[id.xy], ubar_avg_y) * halfTimeStepOverCellSize;
    float2 step_y = float2(0.0f, 0.5f) - float2(ubar_avg_x, ubarNewIn_y[id.xy]) * halfTimeStepOverCellSize;
    // float h_sample_x = SampleCubicClamped2D(htildeIn, id.xy + step_x);
    // float h_sample_y = SampleCubicClamped2D(htildeIn, id.xy + step_y);

    // High-order cubic reconstructed values
    float h_cubic_x = SampleCubicClamped2D(htildeIn, id.xy + step_x);
    float h_cubic_y = SampleCubicClamped2D(htildeIn, id.xy + step_y);
    // 1st-order upwind donor-cell values
    float h_upwind_x = (ubarNewIn_x[id.xy] >= 0.0f) ? htildeIn[curr] : htildeIn[right];
    float h_upwind_y = (ubarNewIn_y[id.xy] >= 0.0f) ? htildeIn[curr] : htildeIn[up];
    // TVD / Slope-limited blend: Use cubic where smooth, blend to upwind near sharp gradients
    float nu_x = abs(ubarNewIn_x[id.xy]) * halfTimeStepOverCellSize;
    float nu_y = abs(ubarNewIn_y[id.xy]) * halfTimeStepOverCellSize;
    float h_sample_x = lerp(h_upwind_x, h_cubic_x, clamp(1.0f - nu_x, 0.0f, 1.0f));
    float h_sample_y = lerp(h_upwind_y, h_cubic_y, clamp(1.0f - nu_y, 0.0f, 1.0f));

    qAdvectOut_x[id.xy] = ubarNewIn_x[id.xy] * h_sample_x;
    qAdvectOut_y[id.xy] = ubarNewIn_y[id.xy] * h_sample_y;
}

[numthreads(16, 16, 1)]
void IntegrateH(uint3 id : SV_DispatchThreadID) {
    // Inputs: qbarIn_x, qtildeIn_x, qAdvect_x, 
    //         qbarIn_y, qtildeIn_y, qAdvect_y, hPast, terrain
    // Outputs: hOut, qOut_x, qOut_y
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr  = int2(id.xy);
    int2 maxGrid = int2(gridSizeX - 1, gridSizeY - 1);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), maxGrid);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), maxGrid);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), maxGrid);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), maxGrid);
    float h_curr = hPast[curr];
    float t_curr = terrain[curr];
    float h_right = hPast[right];
    float t_right = terrain[right];
    float h_left = hPast[left];
    float t_left = terrain[left];
    float h_up = hPast[up];
    float t_up = terrain[up];
    float h_down = hPast[down];
    float t_down = terrain[down];

    // q = qbar + qtilde + qAdvect
    // sponge layer: damp q near edges to absorb waves, simulate an open boundary
    float damping = SpongeDamping(curr);
    float damping_xm = SpongeDamping(left);
    float damping_ym = SpongeDamping(down);
    float q_x  = (qbarIn_x[curr] + qtildeIn_x[curr] + qAdvectIn_x[curr]) * damping;
    float q_y  = (qbarIn_y[curr] + qtildeIn_y[curr] + qAdvectIn_y[curr]) * damping;
    float q_xm = (qbarIn_x[left] + qtildeIn_x[left] + qAdvectIn_x[left]) * damping_xm;
    float q_ym = (qbarIn_y[down] + qtildeIn_y[down] + qAdvectIn_y[down]) * damping_ym;

    // Limit flow to prevent negative water heights and enforce terrain boundaries
    float cflFactor = cflCondition * cellSize / timeStep;
    q_x  = LimitFlowRate(q_x,  h_curr, t_curr, h_right, t_right, cflFactor);
    q_y  = LimitFlowRate(q_y,  h_curr, t_curr, h_up,    t_up,    cflFactor);
    q_xm = LimitFlowRate(q_xm, h_left, t_left, h_curr,  t_curr,  cflFactor);
    q_ym = LimitFlowRate(q_ym, h_down, t_down, h_curr,  t_curr,  cflFactor);

    precise float div_q = (q_x - q_xm + q_y - q_ym) * rcp(cellSize);
    
    // Final height integration
    // Wetting-Aware Laplacian to reduce spikes and unstable grid-scale ripples
    bool isFullyWet = (h_curr > minWaterHeight && h_left > minWaterHeight && 
                    h_right > minWaterHeight && h_up > minWaterHeight && h_down > minWaterHeight);
    if (isFullyWet) {
        precise float laplacian_h = (h_right + h_left + h_up + h_down - 4.0f * h_curr);
        hOut[curr] = clamp(h_curr - timeStep * div_q + laplacianDamping * laplacian_h, 0.f, maxSafeDepth);
    } else {
        hOut[curr] = clamp(h_curr - timeStep * div_q, 0.f, maxSafeDepth);
    }

    // Flow rate output
    float q_out_x = (qbarIn_x[curr] + qtildeIn_x[curr]) * damping; // qbar + qtilde, excluding qAdvect
    float q_out_y = (qbarIn_y[curr] + qtildeIn_y[curr]) * damping;
    qOut_x[curr] = LimitFlowRate(q_out_x, h_curr, t_curr, h_right, t_right, cflFactor);
    qOut_y[curr] = LimitFlowRate(q_out_y, h_curr, t_curr, h_up,    t_up,    cflFactor);
}


/////////// Export ///////////

[numthreads(16, 16, 1)]
void RecomputeH(uint3 id : SV_DispatchThreadID) {
    // Inputs: hIn, terrain
    // Outputs H_Out
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    H_Out[id.xy] = hIn[id.xy] + terrain[id.xy];
}
float ScaleFactor;
[numthreads(16, 16, 1)]
void ScaleCopyDisplacement(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;
    outDisp4[id.xy] = float4(inDispX[id.xy] * ScaleFactor, inDispY[id.xy] * ScaleFactor, inHeight[id.xy] * ScaleFactor, 1.0f);
}

[numthreads(16, 16, 1)]
void CalcSurfaceNormalAndFoam(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)(gridSizeX) || id.y >= (uint)(gridSizeY)) return;

    int2 curr = int2(id.xy);
    int2 right = clamp(curr + int2(1, 0), int2(0, 0), gridSizeX - 1);
    int2 left  = clamp(curr + int2(-1, 0), int2(0, 0), gridSizeX - 1);
    int2 up    = clamp(curr + int2(0, 1), int2(0, 0), gridSizeY - 1);
    int2 down  = clamp(curr + int2(0, -1), int2(0, 0), gridSizeY - 1);

    // --- NORMAL CALCULATION ---
    float invTwoCellSize = 1.0f / max(1e-5f, 2.0f * cellSize);

    // Derivatives with respect to X
    float dDx_dx = (inDispX[right] - inDispX[left]) * invTwoCellSize;
    float dDy_dx = (inDispY[right] - inDispY[left]) * invTwoCellSize;
    float dDz_dx = (inHeight[right] - inHeight[left]) * invTwoCellSize;

    // Derivatives with respect to Y
    float dDx_dy = (inDispX[up] - inDispX[down]) * invTwoCellSize;
    float dDy_dy = (inDispY[up] - inDispY[down]) * invTwoCellSize;
    float dDz_dy = (inHeight[up] - inHeight[down]) * invTwoCellSize;

    // Tangent vectors along X and Y
    float3 Tx = float3(1.0f + dDx_dx, dDy_dx, dDz_dx);
    float3 Ty = float3(dDx_dy, 1.0f + dDy_dy, dDz_dy);

    // Cross product gives normal
    float3 N = cross(Tx, Ty);

    // Invert normal if it points down (Z < 0)
    if (N.z < 0.0f) {
        N = -N;
    }
    N = normalize(N);
    outNormal[curr] = float4(N, 1.0f);

    // --- FOAM AND JACOBIAN CALCULATION ---
    float invCellSize = 1.0f / max(1e-5f, cellSize);

    // Jacobian elements (forward difference)
    float Jxx = 1.0f + (inDispX[right] - inDispX[curr]) * invCellSize;
    float Jyy = 1.0f + (inDispY[up] - inDispY[curr]) * invCellSize;
    float Jyx = (inDispY[right] - inDispY[curr]) * invCellSize;
    float Jxy = (inDispX[up] - inDispX[curr]) * invCellSize;

    // Determinant of Jacobian
    float JacobianDeterminant = Jxx * Jyy - Jxy * Jyx;
    outJacobianDet[curr] = JacobianDeterminant;

    // Minimum Eigenvalue calculation of Jacobian
    float trace = Jxx + Jyy;
    float diff = Jxx - Jyy;
    float term = sqrt(max(0.0f, diff * diff + 4.0f * Jxy * Jyx));
    float EigenValue_ = trace * 0.5f - term * 0.5f;

    // Foam injection
    float Foam = foamMultiplier * saturate(1.0f - EigenValue_ + foamThreshold);

    // Sample previous foam values for blurring and decay
    float PreviousFoamCenter = inPreviousFoam[curr];
    float AccumulatedFoam = inPreviousFoam[up] + inPreviousFoam[down] + inPreviousFoam[right] + inPreviousFoam[left];

    float PreviousFoam = lerp(PreviousFoamCenter, AccumulatedFoam * 0.25f, saturate(timeStep * foamBlur));
    float FadedPreviousFoam = saturate(PreviousFoam - foamFade * timeStep);

    Foam = max(Foam, FadedPreviousFoam);
    outFoam[curr] = Foam;
}

float IntegrationSamples;
float RoughnessPower;
[numthreads(16, 1, 1)]
void CalcRoughnessLUT(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)gridSizeX) return;

    // Seed for LCG random generator
    uint Seed = id.x + uint(time * 1337.0f);
    // Simple LCG random function (returns uniform float in [0, 1])
    #define RAND_FLOAT() (Seed = Seed * 1103515245U + 12345U, float(Seed) / 4294967296.0f)

    float MaxRange = (float(id.x) / max(1.0f, float(gridSizeX - 1))) * 20.48f; // 20.48 to match 2048 in Roughness material function
    float RoughnessSum = 0.0f;
    float GridWorldWidth = float(gridSizeX) * cellSize; // Total size of our grid in meters

    for (int SampleIdx = 0; SampleIdx < 16; ++SampleIdx) {
        // Generate random position A in world space (in meters)
        // Limit to GridWorldWidth to wrap correctly in texture space [0, 1]
        float2 PosA = float2(RAND_FLOAT() * GridWorldWidth, RAND_FLOAT() * GridWorldWidth);

        // Generate second position B uniformly distributed on a circle within MaxRange
        float sin_theta, cos_theta;
        sincos(RAND_FLOAT() * 2.0f * PI, sin_theta, cos_theta);
        float Radius = sqrt(RAND_FLOAT()) * MaxRange;
        float2 PosB = PosA + float2(cos_theta, sin_theta) * Radius;

        // Convert world space to normalized texture coordinates
        float2 uvA = PosA / GridWorldWidth;
        float2 uvB = PosB / GridWorldWidth;

        // Sample normals from the normal map (which is periodic/wrapped)
        float3 NormalA = inNormal.SampleLevel(BilinearWrapSampler, uvA, 0).xyz;
        float3 NormalB = inNormal.SampleLevel(BilinearWrapSampler, uvB, 0).xyz;

        // Express roughness as angle between pair of normals
        float Roughness = dot(NormalA, NormalB);
        Roughness = Roughness * 0.5f + 0.5f;

        RoughnessSum += Roughness;
    }
    #undef RAND_FLOAT
    RoughnessSum /= 16.0f;

    // Load roughness values to combine
    float PrevRoughness = inPreviousRoughness[int2(id.x, 0)]; 
    float NewRoughness = 1.0f - saturate(RoughnessSum); // Invert roughness
    NewRoughness = pow(max(0.0f, NewRoughness), RoughnessPower); // Adjust by user power

    // Weight and combine roughness
    float SampleW = 1.0f / max(1.0f, IntegrationSamples);
    float PrevSampleW = 1.0f - SampleW;
    NewRoughness = PrevRoughness * PrevSampleW + NewRoughness * SampleW;
    outRoughness[int2(id.x, 0)] = NewRoughness;
}